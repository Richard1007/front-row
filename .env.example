# fixture: bundled demonstration data; live: configured real APIs only; auto: live where configured plus fixture fallback
FR_DATA_MODE=fixture
FR_FORECAST_DAYS=90
FR_DEFAULT_COUNTRY_CODE=US
FR_REQUEST_TIMEOUT_MS=10000
FR_LOCAL_DATA_DIR=.data

# Keep these server-side. Never rename them with a VITE_ prefix.
TICKETMASTER_API_KEY=
JAMBASE_API_KEY=

# StubHub requires approved partner credentials and is intentionally disabled in Milestone 0.
STUBHUB_CLIENT_ID=
STUBHUB_CLIENT_SECRET=
